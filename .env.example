# Sao chép thành .env rồi chạy `pnpm dev`. Giá trị dưới đây là giả, chỉ dùng local.
APP_ENV=dev
PORT=3001
# Ứng dụng chạy bằng vai trò hạn chế ecom_app (audit_logs chỉ INSERT/SELECT); migration chạy bằng superuser (MIGRATE_DATABASE_URL),
# job dọn audit dùng ecom_retention. Vai trò do docker/initdb/01-app-roles.sql tạo (docker compose tự chạy khi dựng CSDL mới).
DATABASE_URL=postgresql://ecom_app:ecom_app@localhost:5433/ecom_dev
MIGRATE_DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecom_dev
RETENTION_DATABASE_URL=postgresql://ecom_retention:ecom_retention@localhost:5433/ecom_dev
DB_POOL_MAX=10
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120
OUTBOX_MAX_ATTEMPTS=10
# AUTH (ADR-007, ADR-015): giá trị dưới là mặc định của mã; bỏ comment để đổi (đổi tham số băm hay giới hạn phiên phải chạy sdlc-impact).
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# AUTH_MAX_ACTIVE_SESSIONS=10
# Admin đầu tiên (SB-29): đặt tạm biến AUTH_ADMIN_EMAIL và AUTH_ADMIN_PASSWORD trong môi trường (KHÔNG ghi vào tệp được commit) rồi chạy
# `pnpm --filter @ecom/api auth:create-admin`; không có mật khẩu mặc định, email đã có thì không đổi gì.
# Web: chỉ biến NEXT_PUBLIC_* lộ ra trình duyệt, KHÔNG đặt bí mật ở đây.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# USR (ADR-010, ADR-018): kho ảnh đại diện, dịch vụ S3 tương thích (path-style: <endpoint>/<bucket>/<khóa>). Để trống STORAGE_ENDPOINT chỉ ở dev (tải ảnh đại diện trả 503);
# staging và prod bắt buộc đặt STORAGE_ENDPOINT, STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY (bí mật lấy từ kho bí mật của nền tảng, KHÔNG ghi vào tệp được commit).
# STORAGE_ENDPOINT=https://s3.example.test
# STORAGE_BUCKET=ecom-media
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.test   # gốc URL công khai của ảnh; rỗng thì dùng <endpoint>/<bucket>
# USR_AVATAR_PROCESS_TIMEOUT_MS=10000
