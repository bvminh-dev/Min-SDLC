# Sao chép thành .env rồi chạy `pnpm dev`. Giá trị dưới đây là giả, chỉ dùng local.
APP_ENV=dev
PORT=3001
# Ứng dụng chạy bằng vai trò hạn chế ecom_app (audit_logs chỉ INSERT/SELECT); migration chạy bằng superuser (MIGRATE_DATABASE_URL),
# job dọn audit dùng ecom_retention. Vai trò do docker/initdb/01-app-roles.sql tạo (docker compose tự chạy khi dựng CSDL mới).
DATABASE_URL=postgresql://ecom_app:ecom_app@localhost:5433/ecom_dev
MIGRATE_DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecom_dev
RETENTION_DATABASE_URL=postgresql://ecom_retention:ecom_retention@localhost:5433/ecom_dev
DB_POOL_MAX=10
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://russ-nonevolving-zaida.ngrok-free.dev
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120
OUTBOX_MAX_ATTEMPTS=10
# AUTH (ADR-007, ADR-015): giá trị dưới là mặc định của mã; bỏ comment để đổi (đổi tham số băm hay giới hạn phiên phải chạy sdlc-impact).
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# AUTH_MAX_ACTIVE_SESSIONS=10
# Admin đầu tiên (SB-29): đặt tạm biến AUTH_ADMIN_EMAIL và AUTH_ADMIN_PASSWORD trong môi trường (KHÔNG ghi vào tệp được commit) rồi chạy
# `pnpm --filter @ecom/api auth:create-admin`; không có mật khẩu mặc định, email đã có thì không đổi gì.
# Web: chỉ biến NEXT_PUBLIC_* lộ ra trình duyệt, KHÔNG đặt bí mật ở đây.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Mở web qua ngrok/domain public: chạy web với NEXT_PUBLIC_API_BASE_URL=/api/v1 (web không đọc .env gốc), Next chuyển tiếp sang API, xem rewrites trong apps/web/next.config.mjs.
# USR (ADR-010, ADR-018): kho ảnh đại diện, dịch vụ S3 tương thích (path-style: <endpoint>/<bucket>/<khóa>). Để trống STORAGE_ENDPOINT chỉ ở dev (tải ảnh đại diện trả 503);
# staging và prod bắt buộc đặt STORAGE_ENDPOINT, STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY (bí mật lấy từ kho bí mật của nền tảng, KHÔNG ghi vào tệp được commit).
# STORAGE_ENDPOINT=https://s3.example.test
# STORAGE_BUCKET=ecom-media
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.test   # gốc URL công khai của ảnh; rỗng thì dùng <endpoint>/<bucket>
# USR_AVATAR_PROCESS_TIMEOUT_MS=10000
# PAY (ADR-005, ADR-007): cổng VNPay. VNPAY_HASH_SECRET là bí mật: KHÔNG ghi vào tệp được commit, lấy từ kho bí mật của nền tảng host. Ở dev để trống thì đường dẫn thanh toán trả 503 và mọi IPN bị từ chối (đóng khi chưa cấu hình);
# staging và prod bắt buộc đặt VNPAY_TMN_CODE, VNPAY_HASH_SECRET, VNPAY_PAY_URL, VNPAY_API_URL, VNPAY_RETURN_URL; prod còn từ chối khóa giữ chỗ hoặc ngắn hơn 32 ký tự. `{order_code}` trong VNPAY_RETURN_URL được thay bằng mã đơn.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# VNPAY_RETURN_URL=http://localhost:3000/orders/{order_code}/payment
# VNPAY_IPN_IP_ALLOWLIST=            # tùy chọn: IP của cổng cách nhau bằng dấu phẩy; rỗng là tắt (chữ ký là lớp chính, SB-22)
# PAY_MAX_ATTEMPTS=3                 # số lượt thanh toán tối đa mỗi đơn (1 đến 10); is_final của PaymentFailed theo số này
# PAY_ATTEMPT_URL_TTL_MINUTES=10     # hạn đường dẫn thanh toán, luôn bị chặn trên bởi hạn của Payment
# PAY_REFUND_AUTO_ATTEMPTS=3         # số lần tự thử lại hoàn tiền (tính cả lần đầu, tối đa 3)
# NTF (ADR-007, ADR-010): email qua Amazon SES (SigV4 bằng bộ ký của platform, không SDK). KHÔNG ghi khóa SES vào tệp được commit, lấy từ kho bí mật của nền tảng host. Ở dev để trống thì mọi email thất bại ngay với mã
# `ses_unconfigured` (không gửi đi đâu, thông báo trong ứng dụng không bị ảnh hưởng); staging và prod bắt buộc đặt SES_REGION, MAIL_FROM, APP_BASE_URL (https), SES_ACCESS_KEY, SES_SECRET_KEY.
# APP_BASE_URL là gốc của liên kết trong email (không đường dẫn con); ở dev để trống thì dùng http://localhost:3000. MAIL_FROM là một địa chỉ trần. SES_ENDPOINT chỉ đặt khi dùng điểm cuối riêng hay bộ giả lập.
# SES_REGION=ap-southeast-1
# MAIL_FROM=no-reply@shop.example
# APP_BASE_URL=http://localhost:3000
# SES_ACCESS_KEY=
# SES_SECRET_KEY=
# SES_ENDPOINT=
# SMTP thay cho SES (vd Office 365): đặt SMTP_HOST thì dùng SMTP, ưu tiên hơn SES. Người gửi vẫn là MAIL_FROM (phải trùng hoặc được phép gửi thay SMTP_USER); MAIL_FROM_NAME là tên hiển thị. KHÔNG ghi SMTP_PASSWORD vào tệp được commit.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM_NAME=ECom
# REV (ADR-007, ADR-018): kiểm duyệt trước đánh giá. Mặc định true: đánh giá mới và bản sửa của đánh giá đã đăng vào hàng đợi `pending`, chỉ hiện công khai sau khi admin duyệt. false: tự công bố (admin chỉ hậu kiểm bằng ẩn hoặc xóa).
# Đổi bằng biến môi trường rồi khởi động lại (không có công tắc lúc vận hành). Ảnh đánh giá dùng kho STORAGE_* ở trên (khóa `reviews/<uuid>.webp`).
# REVIEW_PRE_MODERATION=true
# REV_IMAGE_PROCESS_TIMEOUT_MS=10000
