#!/bin/sh
# Chặn commit chứa chuỗi giống bí mật (SB-15). Bỏ qua bằng --no-verify thì CI vẫn quét (job secrets).
root="$(cd "$(dirname "$0")/.." && pwd)"
# GUI git (GitHub Desktop, IDE) chạy hook với PATH tối giản: thêm chỗ cài node phổ biến.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin"
if ! command -v node >/dev/null 2>&1; then
  # nvm: lấy bản mới nhất đã cài
  nvm_node="$(ls -d "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin 2>/dev/null | sort -V | tail -n 1)"
  [ -n "$nvm_node" ] && PATH="$PATH:$nvm_node"
fi
command -v node >/dev/null 2>&1 || { echo "pre-commit: không tìm thấy node trong PATH" >&2; exit 1; }
exec node "$root/scripts/scan-secrets.mjs" --staged
