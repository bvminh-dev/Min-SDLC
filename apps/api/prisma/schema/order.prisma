// Module order (epic ORD, ORD-DB-20261006-092703753): Order, OrderItem, OrderStatusHistory.
// Phần Prisma không biểu diễn được (CHECK, chỉ mục một phần, trigger chỉ-thêm) nằm trong migration SQL.
// Khóa ngoại chỉ trỏ vào bảng của ORD hoặc `users` (AUTH); `product_id`, `shipping_method_id` là cột trơn (ranh giới module, P7, SB-35).

enum OrderStatus {
  pending
  confirmed
  paid
  shipped
  delivered
  cancelled
  expired
  returned

  @@map("order_status")
}

enum OrderPaymentStatus {
  pending
  processing
  succeeded
  failed
  expired
  cancelled
  refunded

  @@map("order_payment_status")
}

enum OrderPaymentMethod {
  vnpay
  cod
  cash
  bank_transfer

  @@map("order_payment_method")
}

enum OrderCancelReason {
  customer_request
  admin
  payment_failed
  stock_commit_failed

  @@map("order_cancel_reason")
}

enum OrderActorRole {
  customer
  admin
  system
  sale

  @@map("order_actor_role")
}

model Order {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?            @map("user_id") @db.Uuid
  code             String             @unique
  status           OrderStatus        @default(pending)
  paymentStatus    OrderPaymentStatus @default(pending) @map("payment_status")
  itemsTotal       BigInt             @map("items_total")
  discount         BigInt
  shippingFee      BigInt             @map("shipping_fee")
  grandTotal       BigInt             @map("grand_total")
  shippingAddress  Json               @map("shipping_address")
  shippingMethodId String             @map("shipping_method_id") @db.Uuid
  paymentMethod    OrderPaymentMethod @map("payment_method")
  paymentExpiresAt DateTime?          @map("payment_expires_at") @db.Timestamptz(6)
  handoffLockedAt  DateTime?          @map("handoff_locked_at") @db.Timestamptz(6)
  trackingNumber   String?            @map("tracking_number")
  cancelReason     OrderCancelReason? @map("cancel_reason")
  cancelledByRole  OrderActorRole?    @map("cancelled_by_role")
  confirmedAt      DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(6)
  deliveredAt      DateTime?          @map("delivered_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  sourceId         String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @map("source_id") @db.Uuid // nguồn đơn; mặc định `website` (id cố định)
  createdBy        String?            @map("created_by") @db.Uuid // người sale hoặc admin tạo hộ; rỗng với đơn khách tự đặt
  customerSnapshot Json?              @map("customer_snapshot") // đơn hộ: { full_name, phone }
  note             String? // ghi chú đơn (đơn hộ), văn bản thuần

  user             User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  creator          User?                @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  source           OrderSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  history          OrderStatusHistory[]
  shipments        Shipment[] // khóa ngoại của SHP (shipments.order_id): chỉ để ràng buộc toàn vẹn, ORD không truy vấn
  payment          Payment? // khóa ngoại của PAY (payments.order_id, unique): chỉ để ràng buộc toàn vẹn, ORD không truy vấn
  checkoutSessions CheckoutSession[] // khóa ngoại của CHK (checkout_sessions.order_id, ON DELETE RESTRICT): chỉ để ràng buộc toàn vẹn, ORD không truy vấn

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([sourceId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String @map("order_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  nameSnapshot String @map("name_snapshot")
  unitPrice    BigInt @map("unit_price")
  quantity     Int
  position     Int // thứ tự dòng khi đặt (ORD-DB không có cột này: id là uuid ngẫu nhiên nên không khôi phục được thứ tự dòng)
  note         String? // ghi chú dòng hàng (đơn hộ), văn bản thuần
  costSnapshot BigInt? @map("cost_snapshot") // giá vốn lúc bán, chỉ admin đọc (SB-42)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviews Review[] // khóa ngoại của REV (reviews.order_item_id, ON DELETE RESTRICT): chỉ để ràng buộc toàn vẹn, ORD không truy vấn

  @@unique([orderId, position])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq        BigInt         @unique @default(autoincrement())
  orderId    String         @map("order_id") @db.Uuid
  fromStatus OrderStatus?   @map("from_status")
  toStatus   OrderStatus    @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  actorRole  OrderActorRole @map("actor_role")
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, seq])
  @@map("order_status_history")
}

/// Danh mục nguồn đơn do admin quản lý (ORD-REQ-20261015-092748678); `website` là nguồn hệ thống của đơn khách tự đặt. Trigger chặn đổi `code`, `is_system` và xóa nằm trong migration SQL.
model OrderSource {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@index([isActive, position, name])
  @@map("order_sources")
}

/// Bộ đếm mã đơn theo ngày giờ Asia/Ho_Chi_Minh (ADR-024): `last` là số thứ tự đã cấp cuối cùng trong ngày.
model OrderCodeCounter {
  day  DateTime @id @db.Date
  last Int

  @@map("order_code_counters")
}
