// Module platform (epic PRJ): AuditLog, OutboxEvent, ProcessedEvent, IdempotencyKey và bộ đếm giới hạn tần suất.
// Phần không biểu diễn được trong Prisma (CHECK, trigger, chỉ mục một phần, UNLOGGED) nằm trong migration SQL.

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorRole     String   @map("actor_role")
  action        String
  targetType    String   @map("target_type")
  targetId      String   @map("target_id")
  before        Json?
  after         Json?
  reason        String?
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  correlationId String    @map("correlation_id")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}

model IdempotencyKey {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String
  key         String
  userId      String   @map("user_id") @db.Uuid
  requestHash String   @map("request_hash")
  response    Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Hạ tầng, không phải entity (ADR-014): bảng UNLOGGED, cửa sổ cố định, mất khi CSDL sự cố là chấp nhận được.
model RateLimitCounter {
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@id([bucket, windowStart])
  @@map("rate_limit_counters")
}
