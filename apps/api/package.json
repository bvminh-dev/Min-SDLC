{
  "name": "@ecom/api",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-jest.mjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node --env-file-if-exists=../../.env scripts/migrate.mjs migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env scripts/migrate.mjs migrate deploy",
    "db:check": "node scripts/check-migrations.mjs",
    "db:seed": "node --env-file-if-exists=../../.env -r ts-node/register src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
